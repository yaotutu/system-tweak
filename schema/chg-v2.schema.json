{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://system-tweak.local/schema/chg-v2.schema.json",
  "title": "system-tweak CHG v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "id", "title", "date", "scope", "domains", "keywords",
    "supersedes", "buildsOn", "manual", "risk", "backupPaths", "intent",
    "ownership", "preconditions", "operations", "lifecycle",
    "postconditions", "rollback", "adapt"
  ],
  "properties": {
    "schema": { "const": 2 },
    "id": { "type": "string", "pattern": "^CHG-[0-9]{4}$" },
    "title": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "format": "date" },
    "scope": { "$ref": "#/$defs/nonEmptyStrings" },
    "domains": { "$ref": "#/$defs/nonEmptyStrings" },
    "keywords": { "$ref": "#/$defs/nonEmptyStrings" },
    "supersedes": { "$ref": "#/$defs/changeIds" },
    "buildsOn": { "$ref": "#/$defs/changeIds" },
    "manual": {
      "oneOf": [
        { "type": "string", "pattern": "^[^/]+\\.md$" },
        { "type": "null" }
      ]
    },
    "risk": { "enum": ["low", "medium", "high"] },
    "backupPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "outcomes"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "outcomes": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths", "services", "packages"],
      "properties": {
        "paths": { "$ref": "#/$defs/strings" },
        "services": { "$ref": "#/$defs/strings" },
        "packages": { "$ref": "#/$defs/strings" }
      }
    },
    "preconditions": {
      "type": "array",
      "items": { "$ref": "#/$defs/assertion" }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operation" }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constraints"],
      "properties": {
        "constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["before", "after"],
            "properties": {
              "before": { "$ref": "#/$defs/opId" },
              "after": { "$ref": "#/$defs/opId" }
            }
          }
        }
      }
    },
    "postconditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automatic", "manual"],
      "properties": {
        "automatic": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/assertion" }
        },
        "manual": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "instructions", "expected"],
            "properties": {
              "id": { "$ref": "#/$defs/testId" },
              "instructions": { "type": "string", "minLength": 1 },
              "expected": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "instructions"],
      "properties": {
        "strategy": { "const": "backup.restore" },
        "instructions": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "adapt": { "$ref": "#/$defs/nonEmptyStrings" }
  },
  "$defs": {
    "strings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "changeIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^CHG-[0-9]{4}$" }
    },
    "opId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "testId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^changes/assets/CHG-[0-9]{4}/[^/].+$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "when": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path"],
      "properties": {
        "type": { "enum": ["path-exists", "path-nonempty"] },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "assertion": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "path"],
          "properties": {
            "id": { "$ref": "#/$defs/testId" },
            "type": { "const": "file.exists" },
            "path": { "type": "string", "minLength": 1 },
            "kind": { "enum": ["any", "file", "directory"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "path", "all"],
          "properties": {
            "id": { "$ref": "#/$defs/testId" },
            "type": { "const": "file.contains" },
            "path": { "type": "string", "minLength": 1 },
            "all": { "$ref": "#/$defs/nonEmptyStrings" },
            "none": { "$ref": "#/$defs/strings" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "name", "state"],
          "properties": {
            "id": { "$ref": "#/$defs/testId" },
            "type": { "const": "service" },
            "name": { "type": "string", "minLength": 1 },
            "scope": { "enum": ["user", "system"] },
            "state": { "enum": ["active", "inactive", "enabled", "disabled"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "names"],
          "properties": {
            "id": { "$ref": "#/$defs/testId" },
            "type": { "const": "package" },
            "names": { "$ref": "#/$defs/nonEmptyStrings" },
            "manager": { "enum": ["pacman"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "argv", "expectedExit"],
          "properties": {
            "id": { "$ref": "#/$defs/testId" },
            "type": { "const": "command" },
            "argv": { "$ref": "#/$defs/nonEmptyStrings" },
            "expectedExit": { "type": "integer" },
            "stdoutContains": { "$ref": "#/$defs/strings" },
            "stderrNotContains": { "$ref": "#/$defs/strings" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "prompt"],
          "properties": {
            "id": { "$ref": "#/$defs/testId" },
            "type": { "const": "manual-decision" },
            "prompt": { "type": "string", "minLength": 1 },
            "when": { "$ref": "#/$defs/when" }
          }
        }
      ]
    },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "manager", "packages", "rollback"],
          "properties": {
            "id": { "$ref": "#/$defs/opId" },
            "type": { "const": "package.ensure" },
            "manager": { "enum": ["pacman", "yay"] },
            "packages": { "$ref": "#/$defs/nonEmptyStrings" },
            "rollback": { "const": "none" },
            "rollbackReason": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "name", "scope", "rollback"],
          "properties": {
            "id": { "$ref": "#/$defs/opId" },
            "type": { "enum": ["service.stop", "service.start", "service.restart"] },
            "name": { "type": "string", "minLength": 1 },
            "scope": { "enum": ["user", "system"] },
            "rollback": { "enum": ["backup", "none"] },
            "rollbackReason": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "destination", "asset", "rollback"],
          "properties": {
            "id": { "$ref": "#/$defs/opId" },
            "type": { "const": "artifact.install" },
            "destination": { "type": "string", "minLength": 1 },
            "asset": { "$ref": "#/$defs/asset" },
            "mode": { "type": "string", "pattern": "^0[0-7]{3}$" },
            "rollback": { "const": "backup" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "path", "sections", "rollback"],
          "properties": {
            "id": { "$ref": "#/$defs/opId" },
            "type": { "const": "file.mergeIni" },
            "path": { "type": "string", "minLength": 1 },
            "sections": { "type": "object", "minProperties": 1 },
            "rollback": { "const": "backup" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "path", "values", "rollback"],
          "properties": {
            "id": { "$ref": "#/$defs/opId" },
            "type": { "const": "file.mergeYaml" },
            "path": { "type": "string", "minLength": 1 },
            "values": { "type": "object", "minProperties": 1 },
            "rollback": { "const": "backup" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "asset", "interpreter", "writes", "rollback"],
          "properties": {
            "id": { "$ref": "#/$defs/opId" },
            "type": { "const": "script.run" },
            "asset": { "$ref": "#/$defs/asset" },
            "interpreter": { "enum": ["python3", "bash"] },
            "args": { "$ref": "#/$defs/strings" },
            "env": { "type": "object", "additionalProperties": { "type": "string" } },
            "writes": { "$ref": "#/$defs/strings" },
            "rollback": { "enum": ["backup", "none"] },
            "rollbackReason": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "argv", "writes", "riskAcknowledgement", "rollback"],
          "properties": {
            "id": { "$ref": "#/$defs/opId" },
            "type": { "const": "command.run" },
            "argv": { "$ref": "#/$defs/nonEmptyStrings" },
            "env": { "type": "object", "additionalProperties": { "type": "string" } },
            "writes": { "$ref": "#/$defs/strings" },
            "riskAcknowledgement": { "type": "string", "minLength": 1 },
            "rollback": { "enum": ["backup", "none"] },
            "rollbackReason": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
