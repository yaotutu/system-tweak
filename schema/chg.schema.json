{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://system-tweak.local/schema/chg.schema.json",
  "title": "system-tweak CHG v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "title",
    "date",
    "scope",
    "domains",
    "keywords",
    "supersedes",
    "buildsOn",
    "manual",
    "risk",
    "requiresBackup",
    "backupPaths",
    "intent",
    "check",
    "apply",
    "adapt",
    "verify",
    "rollback"
  ],
  "properties": {
    "schema": {
      "const": 1,
      "description": "CHG JSON structure version."
    },
    "id": {
      "type": "string",
      "pattern": "^CHG-[0-9]{4}$",
      "description": "Unique, immutable change identifier."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable summary of the requested state."
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Publication date in ISO-8601 date format."
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 },
      "description": "High-level systems affected by this change."
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 },
      "description": "Policy or operational domains used for classification."
    },
    "keywords": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 },
      "description": "Searchable terms for this change."
    },
    "supersedes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^CHG-[0-9]{4}$" },
      "description": "Older CHGs replaced by this CHG. This field participates in skip and audit calculations."
    },
    "buildsOn": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^CHG-[0-9]{4}$" },
      "description": "Design lineage only. This field is not an execution dependency."
    },
    "manual": {
      "oneOf": [
        { "type": "string", "pattern": "^[^/]+\\.md$" },
        { "type": "null" }
      ],
      "description": "Related manual entry, or null if none."
    },
    "risk": {
      "enum": ["low", "medium", "high"],
      "description": "Risk classification. High-risk changes require explicit user approval."
    },
    "requiresBackup": {
      "type": "boolean",
      "description": "Whether applying this change requires a local backup first."
    },
    "backupPaths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 },
      "description": "Persistent paths that should be backed up before apply."
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "outcomes"],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "description": "One-sentence statement of the desired behavior."
        },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "Observable outcomes that define success."
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readOnly", "commands", "expected"],
      "properties": {
        "readOnly": {
          "const": true,
          "description": "Must be true. Check may never modify system state."
        },
        "commands": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Read-only commands used to inspect current state."
        },
        "expected": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "Expected state or behavior when this CHG is satisfied."
        }
      }
    },
    "apply": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selfContained", "steps", "commands"],
      "properties": {
        "selfContained": {
          "const": true,
          "description": "Must be true. Apply cannot assume any older CHG was previously executed."
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "Ordered steps, including backup, mutation, and activation."
        },
        "commands": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Concrete commands or path edits used during apply."
        }
      }
    },
    "adapt": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "Environment-specific adaptation rules and cases requiring user confirmation."
    },
    "verify": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "expected"],
      "properties": {
        "commands": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Commands to verify the result after apply."
        },
        "expected": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "Required post-apply behavior, including manual tests."
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps"],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "Local-resource-only rollback procedure."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "requiresBackup": { "const": true } }
      },
      "then": {
        "properties": {
          "backupPaths": { "minItems": 1 }
        }
      }
    }
  ]
}
