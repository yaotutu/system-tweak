{
  "schema": 1,
  "id": "CHG-0007",
  "title": "Foot 选中文本自动复制",
  "date": "2026-09-24",
  "scope": [
    "Linux",
    "App"
  ],
  "domains": [
    "foot"
  ],
  "keywords": [
    "foot",
    "终端",
    "选中复制",
    "copy-on-select",
    "clipboard"
  ],
  "supersedes": [],
  "buildsOn": [],
  "manual": "foot-selection-copy.md",
  "risk": "low",
  "requiresBackup": true,
  "backupPaths": [
    "~/.config/foot/foot.ini"
  ],
  "intent": {
    "summary": "在 Foot 中选中文本时自动复制到常规剪贴板和 primary selection。",
    "outcomes": [
      "鼠标选中 Foot 文本后自动写入常规剪贴板。",
      "同时保留 primary selection。",
      "其他应用可用 Ctrl+V 或中键粘贴。"
    ]
  },
  "check": {
    "readOnly": true,
    "commands": [
      "grep -n \"^selection-target=\" ~/.config/foot/foot.ini",
      "foot --config=\"$HOME/.config/foot/foot.ini\" --check-config"
    ],
    "expected": [
      "selection-target=both 存在。",
      "配置校验通过。",
      "新开 Foot 窗口并选中文本后，其他应用 Ctrl+V 可粘贴。"
    ]
  },
  "apply": {
    "selfContained": true,
    "steps": [
      "备份 foot.ini。",
      "在 [main] 段中加入 selection-target=both。",
      "校验配置并打开新的 Foot 窗口测试。"
    ],
    "commands": [
      "foot --config=\"$HOME/.config/foot/foot.ini\" --check-config"
    ]
  },
  "adapt": [
    "若只需要常规剪贴板，可改为 clipboard。",
    "若需要禁用自动复制，可改为 none。",
    "该选项必须放在 [main]，不能放到 [key-bindings]。"
  ],
  "verify": {
    "commands": [
      "foot --config=\"$HOME/.config/foot/foot.ini\" --check-config"
    ],
    "expected": [
      "配置校验通过。",
      "新开 Foot 窗口选中文本后，其他应用 Ctrl+V 可粘贴。",
      "支持 primary selection 的应用中键粘贴也可用。"
    ]
  },
  "rollback": {
    "steps": [
      "恢复本机应用该变更前的 foot.ini 备份。",
      "或删除/改回 selection-target 行。",
      "重新执行 foot --check-config 并打开新窗口确认。"
    ]
  }
}
