{
  "schema": 1,
  "id": "CHG-0011",
  "title": "Fcitx5 Mellow Youlan 主题",
  "date": "2026-09-24",
  "scope": [
    "Linux",
    "App"
  ],
  "domains": [
    "fcitx5",
    "rime",
    "theme"
  ],
  "keywords": [
    "fcitx5",
    "rime",
    "theme",
    "Mellow Youlan",
    "classicui",
    "HiDPI"
  ],
  "supersedes": [],
  "buildsOn": [
    "CHG-0001"
  ],
  "manual": null,
  "risk": "low",
  "requiresBackup": true,
  "backupPaths": [
    "~/.config/fcitx5/conf/classicui.conf"
  ],
  "intent": {
    "summary": "让 Fcitx5/Rime 候选窗使用 Mellow Youlan 浅色主题，并保留暗色变体。",
    "outcomes": [
      "候选窗使用 mellow-youlan 浅色主题。",
      "支持 Wayland HiDPI。",
      "保留 mellow-youlan-dark 以便后续切换。",
      "不改变输入法行为或快捷键。"
    ]
  },
  "check": {
    "readOnly": true,
    "commands": [
      "test -d ~/.local/share/fcitx5/themes/mellow-youlan",
      "test -d ~/.local/share/fcitx5/themes/mellow-youlan-dark",
      "grep \"^Theme=\" ~/.config/fcitx5/conf/classicui.conf",
      "systemctl --user is-active omarchy-fcitx5.service"
    ],
    "expected": [
      "两个主题目录存在。",
      "Theme=mellow-youlan。",
      "Fcitx5 服务 active。",
      "日志中没有 classicui 主题加载失败。"
    ]
  },
  "apply": {
    "selfContained": true,
    "steps": [
      "备份 classicui.conf 和现有主题目录。",
      "安装 mellow-youlan 与 mellow-youlan-dark 主题目录。",
      "在 classicui.conf 设置 Theme=mellow-youlan、UseDarkTheme=false、UseAccentColor=true、UseInputMethodLanguage=true、PerScreenDPI=true。",
      "重载 Fcitx5。"
    ],
    "commands": [
      "fcitx5-remote -r",
      "systemctl --user restart omarchy-fcitx5.service"
    ]
  },
  "adapt": [
    "暗色桌面可切换到 mellow-youlan-dark。",
    "不同 Mellow 色系可在同一主题家族内替换。",
    "若主题导致故障，先切回内置主题再排查。"
  ],
  "verify": {
    "commands": [
      "systemctl --user is-active omarchy-fcitx5.service",
      "fcitx5-remote -n"
    ],
    "expected": [
      "服务 active。",
      "fcitx5-remote -n 返回 rime。",
      "日志中 classicui 和 rime 加载成功。",
      "实际输入中文时候选窗显示 Mellow Youlan 样式，大小匹配 HiDPI。"
    ]
  },
  "rollback": {
    "steps": [
      "恢复 classicui.conf 备份，或删除新增配置。",
      "移除新增的 mellow-youlan 和 mellow-youlan-dark 主题目录。",
      "若主题故障，将 Theme 改为 default。",
      "重启 Fcitx5。"
    ]
  }
}
