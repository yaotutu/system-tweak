{
  "schema": 2,
  "id": "CHG-0013",
  "title": "可重放的 Fcitx5/Rime 中文输入配置",
  "date": "2026-09-25",
  "scope": ["Linux", "Omarchy", "App"],
  "domains": ["rime", "fcitx5", "input-method", "hyprland"],
  "keywords": ["Fcitx5", "Rime", "Rime Ice", "雾凇拼音", "Ctrl+Space", "Shift", "ascii_mode", "Hyprland 0.56.2", "keyboard-us"],
  "supersedes": ["CHG-0001"],
  "buildsOn": [],
  "manual": "fcitx5-rime-shift.md",
  "risk": "medium",
  "backupPaths": ["~/.config/fcitx5/profile", "~/.config/fcitx5/config", "~/.local/share/fcitx5/rime"],
  "intent": {
    "summary": "以可重复、可验证的方式配置 Fcitx5/Rime Ice，并让 Ctrl+Space 与 Shift 分别管理框架激活和 Rime 中英文模式。",
    "outcomes": [
      "Fcitx5 profile 同时保留 keyboard-us 非激活态和 rime 激活态。",
      "Ctrl+Space 在 keyboard-us/state=1 与 rime/state=2 之间双向切换。",
      "Fcitx5 不接管 Shift；左、右 Shift 均由 Rime 在按下时切换 ascii_mode。",
      "有未上屏编码时，Shift 先提交原始英文编码，再切换到英文模式。",
      "Rime Ice 主词典及 melt_eng、radical_pinyin 依赖词典均完整部署。",
      "不修改 Fcitx5 Classic UI 主题或 CHG-0012 的主题目录。"
    ]
  },
  "ownership": {
    "paths": ["~/.config/fcitx5/profile", "~/.config/fcitx5/config", "~/.local/share/fcitx5/rime"],
    "services": ["omarchy-fcitx5.service"],
    "packages": ["fcitx5-rime", "librime", "git", "python-yaml"]
  },
  "preconditions": [
    {
      "id": "existing-rime-customization",
      "type": "manual-decision",
      "prompt": "目标机器已有 Rime 自定义配置。确认以键级合并继续，而不是覆盖现有偏好吗？",
      "when": {"type": "path-nonempty", "path": "~/.local/share/fcitx5/rime"}
    }
  ],
  "operations": [
    {
      "id": "ensure-packages",
      "type": "package.ensure",
      "manager": "yay",
      "packages": ["fcitx5-rime", "librime", "git", "python-yaml"],
      "rollback": "none",
      "rollbackReason": "安装软件包默认保留；卸载需要独立用户确认。"
    },
    {
      "id": "stop-fcitx",
      "type": "service.stop",
      "name": "omarchy-fcitx5.service",
      "scope": "user",
      "rollback": "none",
      "rollbackReason": "后续 start 操作恢复服务；失败处理也会尝试恢复原服务状态。"
    },
    {
      "id": "install-rime-ice",
      "type": "script.run",
      "asset": {"path": "changes/assets/CHG-0013/install-rime-ice.sh", "sha256": "9fbae4340de9607cf15e080b01105e13241c24435eecdc5f5a7eb00df275eca7"},
      "interpreter": "bash",
      "args": [],
      "env": {},
      "writes": ["~/.local/share/fcitx5/rime"],
      "rollback": "backup"
    },
    {
      "id": "merge-fcitx-config",
      "type": "script.run",
      "asset": {"path": "changes/assets/CHG-0013/merge-profile.py", "sha256": "6298803f6fc7565ef694a035595b324c560c886132d0aecba5c879709acaad3a"},
      "interpreter": "python3",
      "args": [],
      "env": {},
      "writes": ["~/.config/fcitx5/profile", "~/.config/fcitx5/config"],
      "rollback": "backup"
    },
    {
      "id": "install-shift-processor",
      "type": "artifact.install",
      "destination": "~/.local/share/fcitx5/rime/lua/shift_toggle.lua",
      "asset": {"path": "changes/assets/CHG-0013/shift_toggle.lua", "sha256": "6a3d111d54e00931da50fa3f5eae7f04045d9271640c4ea0b730028610a58534"},
      "mode": "0644",
      "rollback": "backup"
    },
    {
      "id": "disable-release-shift",
      "type": "file.mergeYaml",
      "path": "~/.local/share/fcitx5/rime/default.custom.yaml",
      "values": {"patch": {"ascii_composer/switch_key": {"Shift_L": "noop", "Shift_R": "noop"}}},
      "rollback": "backup"
    },
    {
      "id": "register-shift-processor",
      "type": "file.mergeYaml",
      "path": "~/.local/share/fcitx5/rime/rime_ice.custom.yaml",
      "values": {"patch": {"engine/processors/@before 0": "lua_processor@*shift_toggle"}},
      "rollback": "backup"
    },
    {
      "id": "deploy-rime",
      "type": "command.run",
      "argv": ["rime_deployer", "--build", "~/.local/share/fcitx5/rime", "/usr/share/rime-data", "~/.local/share/fcitx5/rime/build"],
      "env": {},
      "writes": ["~/.local/share/fcitx5/rime"],
      "riskAcknowledgement": "rime_deployer 是 Rime 官方部署工具；输出仅写入已声明的用户数据目录。",
      "rollback": "backup"
    },
    {
      "id": "start-fcitx",
      "type": "service.start",
      "name": "omarchy-fcitx5.service",
      "scope": "user",
      "rollback": "none",
      "rollbackReason": "回滚流程会按备份前服务状态恢复。"
    }
  ],
  "lifecycle": {
    "constraints": [
      {"before": "stop-fcitx", "after": "install-rime-ice"},
      {"before": "stop-fcitx", "after": "merge-fcitx-config"},
      {"before": "stop-fcitx", "after": "install-shift-processor"},
      {"before": "merge-fcitx-config", "after": "start-fcitx"},
      {"before": "deploy-rime", "after": "start-fcitx"}
    ]
  },
  "postconditions": {
    "automatic": [
      {"id": "packages-installed", "type": "package", "manager": "pacman", "names": ["fcitx5-rime", "librime"]},
      {"id": "profile-state", "type": "file.contains", "path": "~/.config/fcitx5/profile", "all": ["DefaultIM=rime", "Name=keyboard-us", "Name=rime"], "none": []},
      {"id": "hotkey-state", "type": "file.contains", "path": "~/.config/fcitx5/config", "all": ["[Hotkey/TriggerKeys]", "0=Control+space", "[Hotkey/AltTriggerKeys]"], "none": []},
      {"id": "rime-main-dictionary", "type": "file.exists", "path": "~/.local/share/fcitx5/rime/build/rime_ice.table.bin", "kind": "file"},
      {"id": "rime-english-dictionary", "type": "file.exists", "path": "~/.local/share/fcitx5/rime/build/melt_eng.table.bin", "kind": "file"},
      {"id": "rime-radical-dictionary", "type": "file.exists", "path": "~/.local/share/fcitx5/rime/build/radical_pinyin.table.bin", "kind": "file"},
      {"id": "fcitx-active", "type": "service", "name": "omarchy-fcitx5.service", "scope": "user", "state": "active"},
      {"id": "framework-toggle", "type": "command", "argv": ["python3", "changes/assets/CHG-0013/verify-toggle.py"], "expectedExit": 0, "stdoutContains": ["toggle-cycle=ok"], "stderrNotContains": ["Traceback", "ERROR"]}
    ],
    "manual": [
      {"id": "ctrl-space-real-field", "instructions": "在真实可输入文本框中连续测试两次 Ctrl+Space。", "expected": "在 keyboard-us/state=1 与 rime/state=2 之间双向切换。"},
      {"id": "both-shifts", "instructions": "Rime 开启时分别轻按左 Shift 和右 Shift。", "expected": "左右 Shift 都能在中文与英文模式间切换。"},
      {"id": "raw-code-commit", "instructions": "中文状态输入 nihao，不选候选，直接按 Shift。", "expected": "上屏原始 nihao 并切换到英文模式。"},
      {"id": "normal-chinese-input", "instructions": "重新切到中文，输入 nihao 并选择候选。", "expected": "出现中文候选并能正常上屏。"}
    ]
  },
  "rollback": {
    "strategy": "backup.restore",
    "instructions": [
      "停止 omarchy-fcitx5.service。",
      "按 run journal 中的 backup manifest 恢复 profile、config 与 Rime 用户目录。",
      "恢复应用前服务状态并重新执行只读检查。",
      "软件包默认保留；卸载需要新的明确用户确认。"
    ]
  },
  "adapt": [
    "网络不可用时，使用已验证的离线 Rime Ice 数据；不得自动移除系统 librime-data。",
    "发现现有 Rime 自定义时必须暂停并取得 manual-decision，随后只做键级合并。",
    "非 Hyprland 0.56.2 环境应先验证 Shift release；上游修复后用更高编号 CHG 取代本 workaround。",
    "不存在 omarchy-fcitx5.service 时必须暂停并选择目标机器实际的用户服务，不得静默替换。",
    "不得修改 classicui.conf 或任何 Fcitx5 主题目录。"
  ]
}
