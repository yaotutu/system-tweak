{
  "schema": 1,
  "id": "CHG-0001",
  "title": "统一中文输入体验",
  "date": "2026-09-23",
  "scope": [
    "Omarchy"
  ],
  "domains": [
    "rime",
    "fcitx5"
  ],
  "keywords": [
    "输入法",
    "中文",
    "拼音",
    "Fcitx5",
    "Rime",
    "雾凇拼音",
    "Shift",
    "中英文"
  ],
  "supersedes": [],
  "buildsOn": [],
  "manual": "fcitx5-rime-shift.md",
  "risk": "medium",
  "requiresBackup": true,
  "backupPaths": [
    "~/.config/fcitx5/profile",
    "~/.config/fcitx5/config",
    "~/.local/share/fcitx5/rime/default.custom.yaml",
    "~/.local/share/fcitx5/rime/rime_ice.custom.yaml",
    "~/.local/share/fcitx5/rime/lua/shift_toggle.lua"
  ],
  "intent": {
    "summary": "让 Fcitx5/Rime 提供稳定的中文输入和中英文切换体验。",
    "outcomes": [
      "默认输入法为 rime。",
      "使用 rime_ice 雾凇拼音。",
      "左、右 Shift 均可切换中英文。",
      "有未上屏编码时，Shift 先提交原始英文编码。"
    ]
  },
  "check": {
    "readOnly": true,
    "commands": [
      "fcitx5-remote -n",
      "pacman -Q fcitx5-rime librime",
      "grep -n \"\\[Hotkey/AltTriggerKeys\\]\" ~/.config/fcitx5/config",
      "test -f ~/.local/share/fcitx5/rime/lua/shift_toggle.lua",
      "grep -n \"lua_processor@\\*shift_toggle\" ~/.local/share/fcitx5/rime/rime_ice.custom.yaml"
    ],
    "expected": [
      "fcitx5-remote -n 返回 rime。",
      "fcitx5-rime 和 librime 已安装。",
      "AltTriggerKeys 不被 Fcitx5 优先拦截。",
      "shift_toggle.lua 存在并已被 Rime 注册。"
    ]
  },
  "apply": {
    "selfContained": true,
    "steps": [
      "备份输入法配置。",
      "安装 fcitx5-rime 和 librime。",
      "在 Fcitx5 profile 中将默认输入法设为 rime，并保留 keyboard-us 与 rime。",
      "在 Fcitx5 config 的 Hotkey/AltTriggerKeys 中写入空条目。",
      "在 Rime 的 default.custom.yaml 中将 Shift_L 和 Shift_R 设为 noop。",
      "在 rime_ice.custom.yaml 中注册 lua_processor@*shift_toggle。",
      "安装 shift_toggle.lua 以提交原始编码并切换中英文。",
      "重新部署 Rime 并重启 Fcitx5。"
    ],
    "commands": [
      "yay -S --needed fcitx5-rime librime",
      "fcitx5-remote -r",
      "systemctl --user restart omarchy-fcitx5.service"
    ]
  },
  "adapt": [
    "目标电脑已有自定义输入法配置时，先比较差异。",
    "不同 Rime 版本需先验证 lua_processor 兼容性。",
    "如果用户不愿改变输入法方案，必须询问后再应用。"
  ],
  "verify": {
    "commands": [
      "fcitx5-remote -n",
      "pacman -Q fcitx5-rime librime",
      "systemctl --user is-active omarchy-fcitx5.service"
    ],
    "expected": [
      "fcitx5-remote -n 返回 rime。",
      "服务处于 active 状态。",
      "输入 nihao 后按左或右 Shift，上屏 nihao 并切换到英文。",
      "再按 Shift 回到中文。"
    ]
  },
  "rollback": {
    "steps": [
      "恢复本机应用该变更前的备份。",
      "重新部署 Rime 并重启 Fcitx5。",
      "如需卸载包，必须先询问用户。"
    ]
  }
}
