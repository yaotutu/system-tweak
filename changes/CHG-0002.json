{
  "schema": 1,
  "id": "CHG-0002",
  "title": "互换左 Alt 与左 Super",
  "date": "2026-09-23",
  "scope": [
    "Omarchy"
  ],
  "domains": [
    "hyprland",
    "keyboard"
  ],
  "keywords": [
    "键盘",
    "左 Alt",
    "Super",
    "Win",
    "AltWin",
    "swap_lalt_lwin"
  ],
  "supersedes": [],
  "buildsOn": [],
  "manual": "hyprland-keyboard-layout.md",
  "risk": "low",
  "requiresBackup": true,
  "backupPaths": [
    "~/.config/hypr/input.lua"
  ],
  "intent": {
    "summary": "互换物理左 Alt 与左 Super，保留右侧 Alt。",
    "outcomes": [
      "物理左 Alt 表现为左 Super。",
      "物理左 Win 表现为左 Alt。",
      "右侧 Alt 行为不变。",
      "保留 compose:caps 和 shift:both_capslock_cancel。"
    ]
  },
  "check": {
    "readOnly": true,
    "commands": [
      "hyprctl getoption input:kb_options"
    ],
    "expected": [
      "返回值包含 altwin:swap_lalt_lwin。",
      "手动按键确认物理左 Alt 触发 Super，物理左 Win 表现为 Alt。"
    ]
  },
  "apply": {
    "selfContained": true,
    "steps": [
      "备份 Hyprland 输入配置。",
      "在 input.lua 的现有 kb_options 中合并追加 altwin:swap_lalt_lwin。",
      "重新加载 Hyprland 配置。"
    ],
    "commands": [
      "hyprctl reload"
    ]
  },
  "adapt": [
    "若键盘固件已经改键，先检测实际键位。",
    "已有其他 kb_options 时应合并，不得覆盖。"
  ],
  "verify": {
    "commands": [
      "hyprctl getoption input:kb_options",
      "hyprctl configerrors"
    ],
    "expected": [
      "kb_options 返回 altwin:swap_lalt_lwin。",
      "左 Alt 触发 Super。",
      "左 Win 表现为 Alt。",
      "右 Alt 不变。"
    ]
  },
  "rollback": {
    "steps": [
      "恢复本机应用该变更前的 input.lua 备份。",
      "执行 hyprctl reload。"
    ]
  }
}
