{
  "schema": 1,
  "id": "CHG-0012",
  "title": "Fcitx5 Mellow theme pre-rendered PNG performance fix",
  "date": "2026-09-24",
  "scope": [
    "Linux",
    "App"
  ],
  "domains": [
    "fcitx5",
    "rime",
    "theme",
    "performance"
  ],
  "keywords": [
    "fcitx5",
    "5.1.22",
    "rime",
    "theme",
    "SVG",
    "PNG",
    "repaint",
    "candidate window",
    "lag",
    "CPU"
  ],
  "supersedes": [
    "CHG-0011"
  ],
  "buildsOn": [
    "CHG-0011"
  ],
  "manual": "fcitx5-522-svg-theme-performance.md",
  "risk": "medium",
  "requiresBackup": true,
  "backupPaths": [
    "~/.config/fcitx5/conf/classicui.conf",
    "~/.local/share/fcitx5/themes/mellow-youlan",
    "~/.local/share/fcitx5/themes/mellow-youlan-dark",
    "~/.local/share/fcitx5/themes/mellow-youlan-png",
    "~/.local/share/fcitx5/themes/mellow-youlan-dark-png"
  ],
  "intent": {
    "summary": "在目标机器上直接安装 Mellow Youlan 视觉主题，并使用预渲染 PNG 避免 Fcitx5 5.1.22 的 SVG 输入卡顿。",
    "outcomes": [
      "视觉仍为 Mellow Youlan。",
      "浅色与暗色主题均可用。",
      "panel 与 highlight 使用 PNG 位图，而不是 SVG。",
      "候选窗不再走 5.1.22 的原生 SVG 路径。",
      "Fcitx5 服务保持 active。",
      "Rime 仍是当前输入法。"
    ]
  },
  "check": {
    "readOnly": true,
    "commands": [
      "test -d ~/.local/share/fcitx5/themes/mellow-youlan-png",
      "grep \"^Theme=\" ~/.config/fcitx5/conf/classicui.conf",
      "systemctl --user is-active omarchy-fcitx5.service",
      "fcitx5-remote -n"
    ],
    "expected": [
      "mellow-youlan-png 目录存在。",
      "Theme=mellow-youlan-png。",
      "Fcitx5 服务 active。",
      "fcitx5-remote -n 返回 rime。",
      "实际连续输入中文时不再出现可感知的输入卡顿。"
    ]
  },
  "apply": {
    "selfContained": true,
    "steps": [
      "备份 classicui.conf，以及已存在的 Mellow 主题目录和 PNG 主题目录。",
      "确认 rsvg-convert 可用；缺失时安装 librsvg。",
      "从 https://github.com/sanweiya/fcitx5-mellow-themes 获取 Mellow Youlan 浅色与暗色主题源文件。",
      "将 mellow-youlan 和 mellow-youlan-dark 安装到 ~/.local/share/fcitx5/themes/，保留 SVG 作为回滚和上游修复后的参考。",
      "为浅色与暗色主题分别创建 *-png 目录，并复制非图片主题配置。",
      "用 rsvg-convert 按 SVG 原始尺寸将 panel.svg 和 highlight.svg 预渲染为 RGBA PNG。",
      "在每个 PNG 主题的 theme.conf 中，把 Image 引用从 SVG 改为对应 PNG。",
      "在 classicui.conf 中设置 Theme=mellow-youlan-png、UseDarkTheme=false、UseAccentColor=true、UseInputMethodLanguage=true、PerScreenDPI=true。",
      "重载 Fcitx5；如服务状态异常，重启 omarchy-fcitx5.service。"
    ],
    "commands": [
      "command -v rsvg-convert || yay -S --needed librsvg",
      "git clone --depth=1 https://github.com/sanweiya/fcitx5-mellow-themes.git \"$TMPDIR/fcitx5-mellow-themes\"",
      "mkdir -p ~/.local/share/fcitx5/themes/mellow-youlan-png",
      "cp -a \"$TMPDIR/fcitx5-mellow-themes/mellow-youlan/.\" ~/.local/share/fcitx5/themes/mellow-youlan-png/",
      "mkdir -p ~/.local/share/fcitx5/themes/mellow-youlan-dark-png",
      "cp -a \"$TMPDIR/fcitx5-mellow-themes/mellow-youlan-dark/.\" ~/.local/share/fcitx5/themes/mellow-youlan-dark-png/",
      "cp -a \"$TMPDIR/fcitx5-mellow-themes/mellow-youlan\" ~/.local/share/fcitx5/themes/",
      "cp -a \"$TMPDIR/fcitx5-mellow-themes/mellow-youlan-dark\" ~/.local/share/fcitx5/themes/",
      "rsvg-convert -o ~/.local/share/fcitx5/themes/mellow-youlan-png/panel.png ~/.local/share/fcitx5/themes/mellow-youlan/panel.svg",
      "rsvg-convert -o ~/.local/share/fcitx5/themes/mellow-youlan-png/highlight.png ~/.local/share/fcitx5/themes/mellow-youlan/highlight.svg",
      "rsvg-convert -o ~/.local/share/fcitx5/themes/mellow-youlan-dark-png/panel.png ~/.local/share/fcitx5/themes/mellow-youlan-dark/panel.svg",
      "rsvg-convert -o ~/.local/share/fcitx5/themes/mellow-youlan-dark-png/highlight.png ~/.local/share/fcitx5/themes/mellow-youlan-dark/highlight.svg",
      "fcitx5-remote -r"
    ]
  },
  "adapt": [
    "暗色桌面可将 Theme 设为 mellow-youlan-dark-png，或将 UseDarkTheme=true 并确认对应主题存在。",
    "网络不可用时，可从本机已有 Mellow 主题源目录或用户提供的离线副本获取 SVG，不得照抄另一台机器的私人配置。",
    "没有 rsvg-convert 时，可用任何能按原始尺寸导出 RGBA PNG 的渲染器，但必须验证尺寸与透明度。",
    "若未来 Fcitx5 修复 SVG 缓存问题，可用更高编号 CHG 取代本 CHG。",
    "如果目标电脑无法使用 PNG，则不要应用本 CHG；应选择其他主题方案并询问用户。"
  ],
  "verify": {
    "commands": [
      "systemctl --user is-active omarchy-fcitx5.service",
      "fcitx5-remote -n",
      "grep \"^Theme=\" ~/.config/fcitx5/conf/classicui.conf"
    ],
    "expected": [
      "服务 active。",
      "fcitx5-remote -n 返回 rime。",
      "Theme=mellow-youlan-png。",
      "连续输入中文时不再出现卡顿。"
    ]
  },
  "rollback": {
    "steps": [
      "恢复应用前备份的 classicui.conf；若原本不存在则删除本次新增配置。",
      "如需完全撤销，移除新增的 mellow-youlan、mellow-youlan-dark、mellow-youlan-png 和 mellow-youlan-dark-png 主题目录。",
      "将 Theme 改回应用前受支持主题；如需临时恢复，可设为 mellow-youlan 或 default。",
      "执行 fcitx5-remote -r；如异常则重启 omarchy-fcitx5.service。"
    ]
  }
}
